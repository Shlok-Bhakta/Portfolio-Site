---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const links = [
  { href: "/#experience", label: "work", optional: true },
  { href: "/projects/", label: "projects" },
  { href: "/blog/", label: "notes" },
  { href: "/resume.pdf", label: "resume", external: true, optional: true },
];

const isActive = (href: string) => href.endsWith("/") && href !== "/" && currentPath.startsWith(href);
---

<header class="site-nav-wrap">
  <nav class="site-nav page-frame" aria-label="Primary navigation">
    <a href="/" class="site-mark" aria-label="Shlok Bhakta, home">shlok<span aria-hidden="true">_</span></a>
    <div class="nav-links">
      {links.map(({ href, label, external, optional }) => (
        <a
          href={href}
          class:list={{ active: isActive(href), optional }}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener" : undefined}
          aria-current={isActive(href) ? "page" : undefined}
        >
          {label}{external && <span aria-hidden="true"> ↗</span>}
        </a>
      ))}
    </div>
  </nav>
</header>
