---
// Binary fluid: a periodic stable-fluids velocity grid carries free-floating
// 0/1 glyphs. Glyphs heat up with local flow speed; fast water turns 0s into
// accent-coloured 1s. Pointer drags the fluid, clicks splash it.
// Put it inside a positioned element marked `data-fluid-stage` to make the
// whole stage (not just the canvas) interactive.
---

<div class="binary-fluid" data-binary-fluid aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  type Depth = { px: number; alpha: number; speed: number };
  type Particles = { n: number; x: Float32Array; y: Float32Array; d: Uint8Array; heat: Float32Array; bit: Uint8Array };

  const DEPTHS: Depth[] = [
    { px: 9, alpha: 0.38, speed: 0.55 },
    { px: 11, alpha: 0.6, speed: 0.8 },
    { px: 14, alpha: 0.9, speed: 1.05 },
  ];
  const TIERS = 5;
  const COLD = [74, 70, 88];

  const hexToRgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  const mix = (a: number[], b: number[], t: number) => a.map((x, i) => Math.round(x + (b[i] - x) * t));

  function mount(host: HTMLElement) {
    const canvas = host.querySelector("canvas");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return () => {};
    const cnv = canvas;
    const g = ctx;
    const stage = host.closest<HTMLElement>("[data-fluid-stage]") ?? host;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let W = 0, H = 0, N = 0, cw = 1, ch = 1, pw = 1, ph = 1, dpr = 1;
    let u = new Float32Array(), v = new Float32Array(), u0 = new Float32Array(), v0 = new Float32Array();
    let pr = new Float32Array(), dv = new Float32Array(), curl = new Float32Array();
    let L = new Int32Array(), R = new Int32Array(), T = new Int32Array(), B = new Int32Array();
    let P: Particles | null = null;
    let sprites: HTMLCanvasElement[][][] = [];

    function accentRgb() {
      const value = getComputedStyle(document.documentElement).getPropertyValue("--accent").trim();
      return /^#[0-9a-f]{6}$/i.test(value) ? hexToRgb(value) : [203, 166, 247];
    }

    function buildSprites() {
      const accent = accentRgb();
      sprites = DEPTHS.map(({ px }) =>
        [0, 1].map((bit) =>
          Array.from({ length: TIERS }, (_, tier) => {
            const t = tier / (TIERS - 1);
            const rgb = t < 0.8 ? mix(COLD, accent, t / 0.8) : mix(accent, [255, 255, 255], (t - 0.8) * 1.6);
            const size = Math.ceil(px * 1.4 * dpr);
            const sprite = document.createElement("canvas");
            sprite.width = sprite.height = size;
            const s = sprite.getContext("2d");
            if (s) {
              s.font = `${px * dpr}px CaskaydiaCoveNF, monospace`;
              s.textAlign = "center";
              s.textBaseline = "middle";
              s.fillStyle = `rgb(${rgb.join(",")})`;
              s.fillText(String(bit), size / 2, size / 2 + dpr * 0.5);
            }
            return sprite;
          }),
        ),
      );
    }

    function sample(f: Float32Array, x: number, y: number) {
      x = ((x % W) + W) % W;
      y = ((y % H) + H) % H;
      const x0 = x | 0, y0 = y | 0, x1 = (x0 + 1) % W, y1 = (y0 + 1) % H, sx = x - x0, sy = y - y0;
      return (
        (f[x0 + y0 * W] * (1 - sx) + f[x1 + y0 * W] * sx) * (1 - sy) +
        (f[x0 + y1 * W] * (1 - sx) + f[x1 + y1 * W] * sx) * sy
      );
    }

    function splat(cx: number, cy: number, radius: number, apply: (i: number, dx: number, dy: number, falloff: number) => void) {
      const r2 = radius * radius;
      for (let y = Math.floor(cy - radius); y <= Math.ceil(cy + radius); y++) {
        for (let x = Math.floor(cx - radius); x <= Math.ceil(cx + radius); x++) {
          const dx = x - cx, dy = y - cy, d2 = dx * dx + dy * dy;
          if (d2 > r2) continue;
          apply(((x % W) + W) % W + (((y % H) + H) % H) * W, dx, dy, (1 - d2 / r2) ** 2);
        }
      }
    }

    const drag = (cx: number, cy: number, vx: number, vy: number, radius: number, k: number) =>
      splat(cx, cy, radius, (i, _dx, _dy, f) => {
        u[i] += (vx - u[i]) * f * k;
        v[i] += (vy - v[i]) * f * k;
      });
    const swirl = (cx: number, cy: number, strength: number, radius: number) =>
      splat(cx, cy, radius, (i, dx, dy, f) => {
        u[i] += (-dy * strength * f) / radius;
        v[i] += (dx * strength * f) / radius;
      });
    const burst = (cx: number, cy: number, strength: number, radius: number) =>
      splat(cx, cy, radius, (i, dx, dy, f) => {
        const d = Math.hypot(dx, dy) + 0.3;
        u[i] += (dx / d) * strength * f;
        v[i] += (dy / d) * strength * f;
      });

    function step(dt: number) {
      // vorticity confinement keeps small curls alive
      for (let i = 0; i < N; i++) curl[i] = 0.5 * (v[R[i]] - v[L[i]] - (u[B[i]] - u[T[i]]));
      for (let i = 0; i < N; i++) {
        const gx = 0.5 * (Math.abs(curl[R[i]]) - Math.abs(curl[L[i]]));
        const gy = 0.5 * (Math.abs(curl[B[i]]) - Math.abs(curl[T[i]]));
        const len = Math.hypot(gx, gy) + 1e-5, c = curl[i] * 2.2 * dt;
        u[i] += (gy / len) * c;
        v[i] -= (gx / len) * c;
      }
      // self-advection
      u0.set(u);
      v0.set(v);
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const i = x + y * W, sx = x - dt * u0[i], sy = y - dt * v0[i];
          u[i] = sample(u0, sx, sy);
          v[i] = sample(v0, sx, sy);
        }
      }
      // pressure projection keeps it incompressible
      for (let i = 0; i < N; i++) {
        dv[i] = -0.5 * (u[R[i]] - u[L[i]] + v[B[i]] - v[T[i]]);
        pr[i] = 0;
      }
      for (let k = 0; k < 14; k++) {
        for (let i = 0; i < N; i++) pr[i] = (dv[i] + pr[L[i]] + pr[R[i]] + pr[T[i]] + pr[B[i]]) * 0.25;
      }
      let mean = 0;
      for (let i = 0; i < N; i++) {
        u[i] = (u[i] - 0.5 * (pr[R[i]] - pr[L[i]])) * 0.997;
        v[i] = (v[i] - 0.5 * (pr[B[i]] - pr[T[i]])) * 0.997;
        mean += u[i];
      }
      // a slow leftward current underneath everything
      const nudge = (-1.1 - mean / N) * 0.03;
      for (let i = 0; i < N; i++) u[i] += nudge;

      if (!P) return;
      for (let k = 0; k < P.n; k++) {
        const su = sample(u, P.x[k] / cw - 0.5, P.y[k] / ch - 0.5);
        const sv = sample(v, P.x[k] / cw - 0.5, P.y[k] / ch - 0.5);
        const speed = DEPTHS[P.d[k]].speed;
        P.x[k] = (P.x[k] + su * cw * dt * speed + (Math.random() - 0.5) * 0.25 + pw) % pw;
        P.y[k] = (P.y[k] + sv * ch * dt * speed + (Math.random() - 0.5) * 0.25 + ph) % ph;
        const target = Math.min(1, Math.max(0, (Math.hypot(su, sv) - 1.4) / 4.5));
        P.heat[k] += (target - P.heat[k]) * Math.min(1, dt * (target > P.heat[k] ? 6 : 1.4));
        if (P.heat[k] > 0.5) P.bit[k] = 1;
        else if (P.heat[k] < 0.28) P.bit[k] = 0;
      }
    }

    function draw(trails: boolean) {
      if (!P) return;
      if (trails) {
        g.globalCompositeOperation = "destination-out";
        g.globalAlpha = 1;
        g.fillStyle = "rgba(0,0,0,.32)";
        g.fillRect(0, 0, pw, ph);
        g.globalCompositeOperation = "source-over";
      } else {
        g.clearRect(0, 0, pw, ph);
      }
      for (let k = 0; k < P.n; k++) {
        const d = P.d[k], heat = P.heat[k];
        const sprite = sprites[d][P.bit[k]][Math.min(TIERS - 1, (heat * TIERS) | 0)];
        const size = sprite.width / dpr;
        g.globalAlpha = DEPTHS[d].alpha * (0.4 + 0.6 * heat);
        g.drawImage(sprite, P.x[k] - size / 2, P.y[k] - size / 2, size, size);
      }
      g.globalAlpha = 1;
    }

    function resize() {
      const bounds = host.getBoundingClientRect();
      pw = Math.max(1, bounds.width);
      ph = Math.max(1, bounds.height);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      cnv.width = Math.round(pw * dpr);
      cnv.height = Math.round(ph * dpr);
      g.setTransform(dpr, 0, 0, dpr, 0, 0);

      W = Math.max(24, Math.min(90, Math.round(pw / 18)));
      H = Math.max(18, Math.min(56, Math.round(ph / 18)));
      N = W * H;
      cw = pw / W;
      ch = ph / H;
      [u, v, u0, v0, pr, dv, curl] = Array.from({ length: 7 }, () => new Float32Array(N));
      [L, R, T, B] = Array.from({ length: 4 }, () => new Int32Array(N));
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const i = x + y * W;
          L[i] = ((x + W - 1) % W) + y * W;
          R[i] = ((x + 1) % W) + y * W;
          T[i] = x + ((y + H - 1) % H) * W;
          B[i] = x + ((y + 1) % H) * W;
        }
      }

      const count = Math.round(Math.max(700, Math.min(3200, (pw * ph) / 650)));
      P = { n: count, x: new Float32Array(count), y: new Float32Array(count), d: new Uint8Array(count), heat: new Float32Array(count), bit: new Uint8Array(count) };
      for (let k = 0; k < count; k++) {
        P.x[k] = Math.random() * pw;
        P.y[k] = Math.random() * ph;
        const r = Math.random();
        P.d[k] = r < 0.45 ? 0 : r < 0.8 ? 1 : 2;
      }
      buildSprites();
      for (let k = 0; k < 7; k++) {
        swirl(Math.random() * W, Math.random() * H, (Math.random() < 0.5 ? -1 : 1) * (4 + Math.random() * 4), 3 + Math.random() * 4);
      }
      g.clearRect(0, 0, pw, ph);
      if (reduceMotion) {
        for (let s = 0; s < 40; s++) step(1 / 30);
        draw(false);
      }
    }

    // invisible paddles tracing slow lissajous paths keep the field moving
    const stirrers = [
      { ax: 0.32, ay: 0.3, fx: 0.00011, fy: 0.00017, px: 0, py: 1.3, cx: 0.7, cy: 0.45 },
      { ax: 0.22, ay: 0.34, fx: 0.00016, fy: 0.00009, px: 2.1, py: 0.2, cx: 0.55, cy: 0.55 },
      { ax: 0.4, ay: 0.18, fx: 0.00007, fy: 0.00013, px: 4.2, py: 3.1, cx: 0.5, cy: 0.3 },
      { ax: 0.3, ay: 0.28, fx: 0.00013, fy: 0.00008, px: 1.1, py: 5.3, cx: 0.8, cy: 0.7 },
    ];
    function stir(t: number) {
      for (const s of stirrers) {
        const x = (s.cx + s.ax * Math.sin(t * s.fx + s.px)) * W;
        const y = (s.cy + s.ay * Math.sin(t * s.fy + s.py)) * H;
        const vx = s.ax * W * s.fx * 1000 * Math.cos(t * s.fx + s.px) * 3.4;
        const vy = s.ay * H * s.fy * 1000 * Math.cos(t * s.fy + s.py) * 3.4;
        drag(x, y, vx, vy, Math.max(3, H * 0.15), 0.09);
      }
    }

    let last: { x: number; y: number; t: number } | null = null;
    function onPointerMove(event: PointerEvent) {
      const bounds = host.getBoundingClientRect(), now = performance.now();
      const x = (event.clientX - bounds.left) / cw, y = (event.clientY - bounds.top) / ch;
      if (last) {
        const dt = Math.max(8, now - last.t) / 1000, cap = 40;
        const vx = Math.max(-cap, Math.min(cap, (x - last.x) / dt));
        const vy = Math.max(-cap, Math.min(cap, (y - last.y) / dt));
        drag(x, y, vx, vy, 3.2, 0.35);
      }
      last = { x, y, t: now };
    }
    function onPointerLeave() {
      last = null;
    }
    function onClick(event: MouseEvent) {
      if ((event.target as HTMLElement).closest("a, button")) return;
      const bounds = host.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / cw, y = (event.clientY - bounds.top) / ch;
      burst(x, y, 14, 5);
      swirl(x, y, 10, 6);
    }

    let visible = true, prev = 0, frame = 0;
    function tick(t: number) {
      frame = requestAnimationFrame(tick);
      if (reduceMotion || !visible || document.hidden || !P) {
        prev = t;
        return;
      }
      const dt = Math.min(1 / 30, Math.max(1 / 144, (t - prev) / 1000 || 1 / 60));
      prev = t;
      stir(t);
      step(dt);
      draw(true);
    }

    const resizeObserver = new ResizeObserver(resize);
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? true;
    });
    resizeObserver.observe(host);
    visibilityObserver.observe(host);
    stage.addEventListener("pointermove", onPointerMove, { passive: true });
    stage.addEventListener("pointerleave", onPointerLeave, { passive: true });
    stage.addEventListener("click", onClick);
    window.addEventListener("accentchange", buildSprites);
    document.fonts.ready.then(buildSprites);
    frame = requestAnimationFrame(tick);

    return () => {
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
      stage.removeEventListener("pointermove", onPointerMove);
      stage.removeEventListener("pointerleave", onPointerLeave);
      stage.removeEventListener("click", onClick);
      window.removeEventListener("accentchange", buildSprites);
    };
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-binary-fluid]:not([data-ready])").forEach((host) => {
      host.dataset.ready = "true";
      const unmount = mount(host);
      document.addEventListener("astro:before-swap", unmount, { once: true });
    });
  });
</script>

<style>
  .binary-fluid,
  .binary-fluid canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .binary-fluid {
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
  }
</style>
