---
import PocketBase from "pocketbase";
import Base from "../../layouts/Base.astro";
import "../../styles/blog.css";

const { id } = Astro.params;
const pb = new PocketBase("https://db.shlokbhakta.dev");
const post = await pb.collection("Posts").getOne(id!);
const image = pb.files.getURL(post, post.Thumbnail);
const published = new Date(post.created)
  .toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  .toLowerCase();
---

<Base title={`${post.Title} | Shlok Bhakta`} description={`A field note by Shlok Bhakta: ${post.Title}`} currentPath="/blog/">
  <main class="article-main page-frame">
    <header class="article-header">
      <a class="article-back" href="/blog/"><span aria-hidden="true">←</span> cd ~/notes</a>
      <p class="article-meta">{published}</p>
      <h1>{post.Title}</h1>
    </header>
    <figure class="article-hero">
      <img src={image} alt="" transition:name={post.Title} loading="eager" decoding="async" />
    </figure>
    <article class="article-body">
      <Fragment set:html={post.Html} />
    </article>
    <footer class="article-footer">
      <p>Thanks for <span class="it">reading</span></p>
      <a class="pill" href="/blog/">more notes →</a>
    </footer>
  </main>
  <script>
    import "../../lib/addcopy";
  </script>
</Base>
