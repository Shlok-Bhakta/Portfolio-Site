---
import PocketBase from "pocketbase";
import Base from "../layouts/Base.astro";
import PostCard from "../components/postCard.astro";
import "../styles/collection.css";

const pb = new PocketBase("https://db.shlokbhakta.dev");
const projects = await pb.collection("Projects").getFullList({
  sort: "-created",
  expand: "Tags",
});

for (const project of projects) {
  project.imageUrl = pb.files.getURL(project, project.Thumbnail);
}
---

<Base
  title="Projects | Shlok Bhakta"
  description="Projects built by Shlok Bhakta, spanning web products, hackathons, infrastructure, and self-hosting."
  currentPath="/projects/"
>
  <main class="collection-main page-frame">
    <header class="collection-header">
      <p class="collection-prompt mono"><b>~</b> $ ls -t ~/projects</p>
      <h1 class="display-title">Projects<sup>{String(projects.length).padStart(2, "0")}</sup></h1>
    </header>
    <ol class="collection-list">
      {projects.map((project, index) => (
        <li class="reveal" transition:name={project.id}>
          <PostCard
            title={project.Title}
            tags={project.expand?.Tags}
            date={project.created}
            image={project.imageUrl}
            link={`/project/${project.id}-${project.Title}`}
            index={index}
          />
        </li>
      ))}
    </ol>
  </main>
</Base>
