---
import PocketBase from "pocketbase";
import Base from "../layouts/Base.astro";
import PostCard from "../components/postCard.astro";
import "../styles/collection.css";

const pb = new PocketBase("https://db.shlokbhakta.dev");
const posts = await pb.collection("Posts").getList(1, 30, {
  expand: "tagName",
  sort: "-created",
});

for (const post of posts.items) {
  post.imageUrl = pb.files.getURL(post, post.Thumbnail);
}
---

<Base
  title="Notes | Shlok Bhakta"
  description="Field notes from Shlok Bhakta about software, infrastructure, experiments, and lessons learned."
  currentPath="/blog/"
>
  <main class="collection-main page-frame">
    <header class="collection-header">
      <p class="collection-prompt mono"><b>~</b> $ ls -t ~/notes</p>
      <h1 class="display-title">Notes<sup>{String(posts.totalItems).padStart(2, "0")}</sup></h1>
    </header>
    <ol class="collection-list">
      {posts.items.map((post, index) => (
        <li class="reveal">
          <PostCard
            title={post.Title}
            tags={post.expand?.tagName}
            date={post.created}
            image={post.imageUrl}
            link={`/post/${post.id}`}
            index={index}
          />
        </li>
      ))}
    </ol>
  </main>
</Base>
