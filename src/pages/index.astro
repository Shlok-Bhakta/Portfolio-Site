---
import Base from "../layouts/Base.astro";
import BinaryFluid from "../components/homepage/BinaryFluid.astro";
import experienceData from "../data/experience.json";
import skillsData from "../data/skills.json";
import "../styles/homepage.css";

const MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];

// "05/2025" -> { month: "may", year: "2025" }; anything else (e.g. "Present") -> null
function parseMonth(value: string) {
  const match = value.trim().match(/^(\d{1,2})\/(\d{4})$/);
  return match ? { month: MONTHS[Number(match[1]) - 1], year: match[2], sort: Number(match[2]) * 100 + Number(match[1]) } : null;
}

// "05/2025 - 08/2025" -> "may — aug 2025", "08/2024 - Present" -> "aug 2024 — now"
function formatRange(range: string) {
  const [startRaw, endRaw = ""] = range.split(" - ");
  const start = parseMonth(startRaw), end = parseMonth(endRaw);
  if (!start) return range.toLowerCase();
  if (!end) return `${start.month} ${start.year} — now`;
  return start.year === end.year
    ? `${start.month} — ${end.month} ${end.year}`
    : `${start.month} ${start.year} — ${end.month} ${end.year}`;
}

const links = [
  { href: "https://github.com/Shlok-Bhakta", label: "github" },
  { href: "https://linkedin.com/in/shlokbhakta", label: "linkedin" },
  { href: "/resume.pdf", label: "resume" },
];

const jobs = experienceData["Work Experience"].map((job) => ({
  company: job.organization.replace(/ University$/, ""),
  role: job.title,
  when: formatRange(job.date),
  url: job.url,
}));

const side = experienceData["Personal Projects and Events"];
const isHackathon = (entry: (typeof side)[number]) => /hack/i.test(entry.organization);

const hackathons = side.filter(isHackathon).map((entry) => {
  const date = parseMonth(entry.date);
  return {
    title: entry.title,
    url: entry.url,
    event: entry.organization.split(" - ")[0],
    when: date ? `${date.month} ${date.year}` : entry.date,
    award: /winner/i.test(entry.organization) ? ("award" in entry ? `winner · ${entry.award}` : "winner") : null,
  };
});

const projects = side
  .filter((entry) => !isHackathon(entry))
  .map((entry) => ({ entry, date: parseMonth(entry.date) }))
  .sort((a, b) => (a.date?.sort ?? 0) - (b.date?.sort ?? 0))
  .map(({ entry, date }) => ({
    title: entry.title,
    url: entry.url,
    year: date?.year ?? "",
    stack: entry.tags.slice(0, 3).map((tag) => tag.name.toLowerCase()).join(" · "),
  }));

const stack = Object.values(skillsData).flat().map((skill) => skill.name);
const stackStyles = ["", "dim", "it"];
const numerals = ["i", "ii", "iii", "iv", "v", "vi", "vii", "viii", "ix", "x"];
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base
  title="Shlok Bhakta | software engineer"
  description="Shlok Bhakta is a software engineer who builds full-stack products, cloud infrastructure, and an unnecessarily capable homelab."
  currentPath="/"
>
  <main>
    <section class="hero" data-fluid-stage aria-labelledby="hero-title">
      <BinaryFluid />
      <div class="hero-inner page-frame">
        <p class="whoami mono"><b>~</b> $ whoami → software engineer</p>
        <h1 id="hero-title">Shlok<br />Bhakta<span class="dot">.</span></h1>
        <div class="hero-links">
          {links.map(({ href, label }) => (
            <a class="pill" href={href} target="_blank" rel="noopener">{label} <span class="k" aria-hidden="true">↗</span></a>
          ))}
          <a class="pill solid" href="mailto:shlokbhakta1@gmail.com">email me</a>
        </div>
      </div>
      <span class="stir" aria-hidden="true">stir ↯ splash</span>
    </section>

    <div class="marquee" aria-label="Tools I use">
      <div class="marquee-track">
        {[0, 1].map((copy) => (
          <div class="marquee-run" aria-hidden={copy === 1 ? "true" : undefined}>
            {stack.map((name, i) => (
              <span class={stackStyles[i % stackStyles.length]}>{name}<i aria-hidden="true">✦</i></span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <section class="block page-frame" id="experience" aria-labelledby="experience-title">
      <h2 class="display-title section-title reveal" id="experience-title">Experience<sup>{pad(jobs.length)}</sup></h2>
      <div class="jobs">
        {jobs.map((job) => (
          <a class="job reveal" href={job.url} target="_blank" rel="noopener">
            <span class="company">{job.company}</span>
            <span class="role">{job.role}</span>
            <span class="when">{job.when}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="block page-frame" id="hackathons" aria-labelledby="hackathons-title">
      <h2 class="display-title section-title reveal" id="hackathons-title">Hackathons<sup>{pad(hackathons.length)}</sup></h2>
      <div class="hacks">
        {hackathons.map((hack) => (
          <a class:list={["hack", "reveal", { win: hack.award }]} href={hack.url} target="_blank" rel="noopener">
            <div class="hack-top"><b>{hack.event}</b><span>{hack.when}</span></div>
            <div>
              <h3>{hack.title}</h3>
              <div class="hack-foot">
                {hack.award ? <span class="award">★ {hack.award}</span> : <span />}
                <span class="arrow" aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="block page-frame" id="projects" aria-labelledby="projects-title">
      <h2 class="display-title section-title reveal" id="projects-title">Projects<sup>{pad(projects.length)}</sup></h2>
      <ol class="projects">
        {projects.map((project, i) => (
          <li class="reveal">
            <a class="project" href={project.url} target="_blank" rel="noopener" data-chip={project.stack}>
              <span class="numeral">{numerals[i] ?? i + 1}.</span>
              <span class="project-title">{project.title}</span>
              <span class="year">{project.year}</span>
            </a>
          </li>
        ))}
      </ol>
      <a class="archive-link mono reveal" href="/projects/">full archive →</a>
    </section>

    <section class="closing page-frame" aria-labelledby="closing-title">
      <h2 class="reveal" id="closing-title"><a href="mailto:shlokbhakta1@gmail.com">Let's <span class="it">talk</span></a></h2>
      <div class="hero-links reveal">
        {links.map(({ href, label }) => (
          <a class="pill" href={href} target="_blank" rel="noopener">{label} <span class="k" aria-hidden="true">↗</span></a>
        ))}
        <a class="pill" href="/blog/">notes →</a>
      </div>
    </section>
  </main>

  <div class="cursor-chip" data-cursor-chip aria-hidden="true"></div>

  <script>
    // Scattered 0/1 texture behind the hackathon tiles, tinted with the accent.
    function paintHackTexture() {
      const tiles = document.querySelectorAll<HTMLElement>(".hack");
      if (!tiles.length) return;
      const size = 220, dpr = Math.min(window.devicePixelRatio || 1, 2);
      const canvas = document.createElement("canvas");
      canvas.width = canvas.height = size * dpr;
      const g = canvas.getContext("2d");
      if (!g) return;
      const accent = getComputedStyle(document.documentElement).getPropertyValue("--accent").trim();
      g.scale(dpr, dpr);
      g.font = "11px CaskaydiaCoveNF, monospace";
      g.textAlign = "center";
      g.textBaseline = "middle";
      let seed = 7;
      const random = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
      for (let k = 0; k < 260; k++) {
        const hot = random() < 0.18;
        g.fillStyle = hot ? accent : "#5a5570";
        g.globalAlpha = hot ? 0.9 : 0.35 + random() * 0.4;
        g.fillText(hot ? "1" : "0", random() * size, random() * size);
      }
      const url = `url(${canvas.toDataURL()})`;
      tiles.forEach((tile) => tile.style.setProperty("--texture", url));
    }

    // Tech-stack chip that follows the cursor over the project list.
    function setupCursorChip() {
      const chip = document.querySelector<HTMLElement>("[data-cursor-chip]");
      if (!chip) return;
      const move = (event: PointerEvent) => {
        chip.style.left = `${event.clientX}px`;
        chip.style.top = `${event.clientY}px`;
      };
      document.querySelectorAll<HTMLElement>(".project").forEach((project) => {
        project.addEventListener("pointerenter", (event) => {
          move(event);
          chip.textContent = project.dataset.chip ?? "";
          chip.classList.add("on");
        });
        project.addEventListener("pointermove", move, { passive: true });
        project.addEventListener("pointerleave", () => chip.classList.remove("on"));
      });
    }

    window.addEventListener("accentchange", paintHackTexture);
    document.addEventListener("astro:page-load", () => {
      setupCursorChip();
      document.fonts.ready.then(paintHackTexture);
    });
  </script>
</Base>
