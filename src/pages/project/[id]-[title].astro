---
import PocketBase from "pocketbase";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/postCard.astro";
import "../../styles/blog.css";

const { id } = Astro.params;
const pb = new PocketBase("https://db.shlokbhakta.dev");
const project = await pb.collection("Projects").getOne(id!);
const image = pb.files.getURL(project, project.Thumbnail);
const relatedPosts = await pb.collection("Posts").getFullList({
  filter: `tagName ~ "${project.ProjectTag}"`,
  expand: "tagName",
  sort: "-created",
});

for (const post of relatedPosts) {
  post.imageUrl = pb.files.getURL(post, post.Thumbnail);
}
---

<Base title={`${project.Title} | Shlok Bhakta`} description={`${project.Title}, a project by Shlok Bhakta.`} currentPath="/projects/">
  <main class="article-main page-frame">
    <header class="article-header">
      <a class="article-back" href="/projects/"><span aria-hidden="true">←</span> cd ~/projects</a>
      <p class="article-meta">project</p>
      <h1>{project.Title}</h1>
    </header>
    <figure class="article-hero">
      <img src={image} alt="" transition:name={project.Title} loading="eager" decoding="async" />
    </figure>
    <article class="article-body">
      <Fragment set:html={project.Html} />
    </article>

    {relatedPosts.length > 0 && (
      <section class="related-posts" aria-labelledby="related-title">
        <h2 class="display-title" id="related-title">Related<sup>{String(relatedPosts.length).padStart(2, "0")}</sup></h2>
        <ol>
          {relatedPosts.map((post) => (
            <li>
              <PostCard
                title={post.Title}
                tags={post.expand?.tagName}
                date={post.created}
                image={post.imageUrl}
                link={`/post/${post.id}`}
              />
            </li>
          ))}
        </ol>
      </section>
    )}
  </main>
  <script>
    import "../../lib/addcopy";
  </script>
</Base>
